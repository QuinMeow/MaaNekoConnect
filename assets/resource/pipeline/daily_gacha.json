{
    "DailyGacha_FreeLabel": {
        "recognition": "TemplateMatch",
        "template": "daily/ad_free.png",
        "roi": [
            255,
            995,
            220,
            50
        ],
        "threshold": 0.97
    },
    "Daily_GachaPage": {
        "recognition": "TemplateMatch",
        "template": "daily/gacha_title.png",
        "roi": [
            35,
            25,
            125,
            60
        ],
        "threshold": 0.97
    },
    "Daily_GachaBegin": {
        "recognition": "DirectHit",
        "post_delay": 0,
        "timeout": 30000,
        "next": [
            "Daily_PostError",
            "Daily_AdPreview",
            "DailyGacha_AdEmpty",
            "DailyGacha_NextGate"
        ],
        "on_error": [
            "CommonRecoveryEnter"
        ]
    },
    "Daily_GachaNext": {
        "recognition": "And",
        "all_of": [
            "Daily_GachaPage",
            "NavFooter_Home"
        ],
        "action": "Click",
        "target": [
            635,
            880,
            30,
            30
        ],
        "max_hit": 5,
        "post_delay": 1600,
        "next": [
            "Daily_GachaBegin"
        ],
        "on_error": [
            "Daily_StopCapture"
        ]
    },
    "Daily_AdPreview": {
        "focus": {"Node.Action.Succeeded": "[广告抽卡] 已打开广告免费确认，剩余免费次数 1。"},
        "recognition": "And",
        "all_of": [
            "DailyGacha_AdReady"
        ],
        "action": "Click",
        "target": [300, 1040, 120, 60],
        "max_hit": 1,
        "next": [
            "DailyGacha_ConfirmGate"
        ],
        "post_delay": 1600,
        "on_error": ["CommonRecoveryEnter"],
        "attach": {
            "result": "free_ad_confirmation_opened",
            "draw": false
        }
    },
    "DailyGacha_AdReady": {
        "recognition": "And",
        "all_of": [
            "Daily_GachaPage",
            "DailyGacha_FreeLabel",
            {
                "recognition": "OCR",
                "roi": [385, 1123, 50, 27],
                "expected": ["^1回$"],
                "replace": [["\\s", ""]],
                "only_rec": true,
                "threshold": 0.95
            }
        ]
    },
    "DailyGacha_AdEmpty": {
        "focus": {"Node.Action.Succeeded": "[广告抽卡] 广告免费次数=0。"},
        "recognition": "And",
        "all_of": [
            "Daily_GachaPage",
            "DailyGacha_FreeLabel",
            {"recognition": "OCR", "roi": [385, 1123, 50, 27], "expected": ["^0回$"],
             "replace": [["\\s", ""]], "only_rec": true, "threshold": 0.95}
        ],
        "post_delay": 0,
        "next": ["Daily_Return"],
        "attach": {"result": "no_free_ad_attempt"}
    },
    "DailyGacha_NextGate": {
        "recognition": "And",
        "all_of": ["Daily_GachaPage", "NavFooter_Home"],
        "post_delay": 0,
        "next": ["Daily_GachaNext", "Daily_StopCapture"],
        "on_error": ["Daily_StopCapture"]
    },
    "DailyGacha_ConfirmGuard": {
        "recognition": "And",
        "all_of": [
            {"recognition": "OCR", "roi": [220, 337, 285, 42],
             "expected": ["^ネコガチャ[（(]広告視聴[)）]$"], "replace": [["\\s", ""]],
             "only_rec": true, "threshold": 0.95},
            {"recognition": "OCR", "roi": [420, 780, 200, 36],
             "expected": ["^広告視聴で1回無料$"], "replace": [["\\s", ""]],
             "only_rec": true, "threshold": 0.95},
            {"recognition": "OCR", "roi": [490, 815, 60, 45],
             "expected": ["^1回$"], "replace": [["\\s", ""]],
             "only_rec": true, "threshold": 0.95},
            {"recognition": "ColorMatch", "method": 4, "roi": [395, 820, 245, 35],
             "lower": [220, 45, 55], "upper": [255, 130, 145], "count": 4000}
        ]
    },
    "DailyGacha_ConfirmGate": {
        "recognition": "And",
        "all_of": ["DailyGacha_ConfirmGuard"],
        "post_delay": 0,
        "next": ["DailyGacha_AdSpend", "Daily_StopCapture"],
        "on_error": ["Daily_StopCapture"]
    },
    "DailyGacha_AdSpend": {
        "focus": {"Node.Action.Succeeded": "[广告抽卡] 已提交免费单抽 1 次，等待广告。", "Node.Action.Failed": "[广告抽卡] 异常：单抽提交失败。"},
        "recognition": "And",
        "all_of": ["DailyGacha_ConfirmGuard"],
        "action": "Click",
        "target": [485, 820, 70, 30],
        "max_hit": 1,
        "post_delay": 3000,
        "anchor": {"CommonRecoveryResume": "Daily_StopCapture"},
        "next": ["DailyGacha_AdPoll"],
        "on_error": ["Daily_StopCapture"],
        "attach": {"attempt": "free_advertisement_gacha", "paid": false}
    },
    "DailyGacha_AdPoll": {
        "recognition": "DirectHit",
        "post_delay": 0,
        "next": ["Daily_PostError", "DailyGacha_ConfirmStillVisible",
                 "DailyGacha_AdQuotaConsumed", "DailyGacha_GameStillVisible", "DailyGacha_AdStep"],
        "on_error": ["Daily_StopCapture"]
    },
    "DailyGacha_ConfirmStillVisible": {
        "recognition": "And",
        "all_of": ["DailyGacha_ConfirmGuard"],
        "post_delay": 0,
        "next": ["DailyGacha_WaitForSDK", "DailyGacha_AdUnavailable"]
    },
    "DailyGacha_AdQuotaConsumed": {
        "focus": {"Node.Action.Succeeded": "[广告抽卡] 免费次数=0。"},
        "recognition": "And",
        "all_of": ["DailyGacha_AdEmpty", "NavFooter_Home"],
        "action": "Screencap",
        "filename": "daily_ad_quota_consumed",
        "format": "png",
        "post_delay": 0,
        "next": ["Daily_Return"],
        "on_error": ["Daily_StopCapture"],
        "attach": {"result": "free_ad_quota_consumed", "draw_result_page_observed": false}
    },
    "DailyGacha_GameStillVisible": {
        "recognition": "And",
        "all_of": ["Daily_GachaPage", "NavFooter_Home"],
        "post_delay": 0,
        "next": ["DailyGacha_WaitForSDK", "DailyGacha_AdUnavailable"],
        "on_error": ["Daily_StopCapture"]
    },
    "DailyGacha_WaitForSDK": {
        "recognition": "DirectHit",
        "max_hit": 7,
        "post_delay": 3000,
        "next": ["DailyGacha_AdPoll"],
        "on_error": ["Daily_StopCapture"]
    },
    "DailyGacha_AdUnavailable": {
        "focus": {"Node.Action.Succeeded": "[广告抽卡] 异常：广告或抽卡结果未识别。"},
        "recognition": "DirectHit",
        "action": "Screencap",
        "filename": "daily_ad_unavailable",
        "format": "png",
        "post_delay": 0,
        "next": ["Daily_StopCapture"],
        "attach": {"result": "advertisement_not_observed_no_draw_credit_confirmed"}
    },
    "DailyGacha_AdStep": {
        "focus": {"Node.Action.Failed": "[广告抽卡] 异常：广告关闭失败或超时。"},
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "AdCloseControl",
        "custom_action_param": {},
        "max_hit": 41,
        "post_delay": 3000,
        "next": ["DailyGacha_AdPoll"],
        "on_error": ["Daily_StopCapture"]
    },
    "DailyGacha_Start": {
        "focus": {"Node.Action.Succeeded": "[广告抽卡] 开始免费单抽。"},
        "doc": "广告抽卡",
        "recognition": "DirectHit",
        "post_delay": 0,
        "anchor": {
            "CommonRecoveryResume": "DailyCore_Recover",
            "Daily_AfterWork": "DailyCore_Done",
            "NavHome_Return": "DailyGacha_ConfigCheck"
        },
        "next": [
            "NavHome_Ensure"
        ],
        "on_error": [
            "CommonRecoveryEnter"
        ]
    },
    "DailyGacha_ConfigCheck": {
        "focus": {"Node.Action.Succeeded": "[广告抽卡] 查找免费广告池。", "Node.Action.Failed": "[广告抽卡] 广告 AI 未启用，请运行 ConfigureAdAI.vbs。"},
        "doc": "运行前请双击 ConfigureAdAI.vbs 配置并启用广告 AI；未配置不打开广告。",
        "action": "Custom",
        "custom_action": "AdCloseConfigured",
        "custom_action_param": {},
        "post_delay": 0,
        "next": ["DailyGacha_OpenHome"],
        "on_error": ["Daily_StopCapture"]
    },
    "DailyGacha_OpenHome": {
        "recognition": "And",
        "all_of": ["NavHome_Ready"],
        "action": "Click",
        "target": [65, 1200, 30, 30],
        "max_hit": 3,
        "post_delay": 2500,
        "next": ["Daily_GachaBegin"],
        "on_error": ["CommonRecoveryEnter"]
    },
    "DailyGacha_AdCloseNative": {
        "recognition": "DirectHit",
        "enabled": false
    },
    "DailyGacha_AdState": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "AdCloseControl",
        "custom_action_param": {"frames": 0, "calls": 0, "clicks": 0},
        "enabled": false
    }
}
