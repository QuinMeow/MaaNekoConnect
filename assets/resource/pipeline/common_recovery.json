        "next": ["CommonRecoveryEnter"],
        "on_error": ["CommonRecoveryStopCapture"]
    },
    "CommonNetworkConfirm": {
        "recognition": "And",
        "all_of": ["CommonNetworkMessage", "CommonNetworkButton"],
