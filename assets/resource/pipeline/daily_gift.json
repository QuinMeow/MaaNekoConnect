{
    "Daily_GiftPage": {
        "recognition": "TemplateMatch", "template": "daily/gift_title.png",
        "roi": [35, 25, 185, 60], "threshold": 0.97
    },
    "Daily_PendingGift": {
        "recognition": "And",
        "all_of": [
            "Daily_Page",
            {"recognition": "TemplateMatch", "template": "daily/pending_gift.png",
             "roi": [85, 300, 555, 600], "threshold": 0.9, "sub_name": "row"},
            {"recognition": "OCR", "roi": "row", "roi_offset": [370, -2, -308, 4],
             "expected": ["^[（(]?0[/／]1[)）]?$"], "replace": [["\\s", ""]],
             "only_rec": true, "threshold": 0.95}
        ],
        "box_index": 1
    },
    "Daily_ChooseGift": {
        "recognition": "And",
        "all_of": [
            "Daily_PendingGift",
            {"recognition": "TemplateMatch", "template": "daily/challenge.png",
             "roi": "Daily_PendingGift", "roi_offset": [390, 65, -198, 82], "threshold": 0.94}
        ],
        "enabled": false, "box_index": 1, "action": "Click", "target": true,
        "max_hit": 1, "post_delay": 2500, "timeout": 45000,
        "next": ["Daily_GiftBegin"], "on_error": ["CommonRecoveryEnter"]
    },
    "DailyGift_Start": {
        "doc": "礼物关卡",
        "recognition": "DirectHit", "post_delay": 0,
        "anchor": {"CommonRecoveryResume": "DailyCore_Recover", "Daily_AfterWork": "DailyCore_Done",
                   "NavHome_Return": "DailyCore_Quest", "DailyCore_QuestTarget": "DailyGift_Open",
                   "DailyGift_BottomProof": "DailyGift_NoProof", "DailyGift_SearchPermit": "Daily_StopCapture"},
        "next": ["NavHome_Ensure"], "on_error": ["CommonRecoveryEnter"]
    },
    "DailyGift_Open": {
        "recognition": "And", "all_of": ["DailyCore_QuestPage"],
        "action": "Click", "target": [545, 830, 30, 30], "max_hit": 1,
        "post_delay": 2000, "timeout": 30000,
        "next": ["Daily_GiftBegin"], "on_error": ["CommonRecoveryEnter"]
    },
    "DailyGift_Tab": {
        "recognition": "And",
        "all_of": [
            {"recognition": "OCR", "roi": [35, 1090, 315, 50], "expected": ["^ギフト集め$"],
             "threshold": 0.95, "only_rec": true},
            {"recognition": "ColorMatch", "method": 4, "roi": [45, 1102, 290, 25],
             "lower": [220, 45, 55], "upper": [255, 130, 145], "count": 3000}
        ]
    },
    "DailyGift_PositiveQuota": {
        "recognition": "OCR", "roi": [254, 116, 60, 35], "only_rec": true,
        "expected": ["^[1-3][/／]3$"], "replace": [["\\s", ""]], "threshold": 0.95
    },
    "Daily_GiftBegin": {
        "recognition": "And", "all_of": ["Daily_GiftPage", "DailyGift_Tab", "NavFooter_Home"],
        "post_delay": 0, "timeout": 30000,
        "next": ["DailyGift_Exhausted", "DailyGift_ScrollBottom", "Daily_StopCapture"],
        "on_error": ["Daily_StopCapture"]
    },
    "DailyGift_Exhausted": {
        "recognition": "And",
        "all_of": [
            "Daily_GiftPage", "DailyGift_Tab", "NavFooter_Home",
            {"recognition": "OCR", "roi": [254, 116, 60, 35], "only_rec": true,
             "expected": ["^0[/／]3$"], "replace": [["\\s", ""]], "threshold": 0.95}
        ],
        "post_delay": 0, "next": ["Daily_Return"], "on_error": ["Daily_StopCapture"],
        "attach": {"reason": "No gift challenge attempts remain; no purchase attempted"}
    },
    "DailyGift_ScrollBottom": {
        "recognition": "And",
        "all_of": ["Daily_GiftPage", "DailyGift_Tab", "DailyGift_PositiveQuota", "NavFooter_Home"],
        "action": "Swipe", "begin": [410, 900], "end": [410, 250], "duration": 400,
        "repeat": 6, "max_hit": 1, "post_delay": 1200,
        "next": ["DailyGift_SelectGate"], "on_error": ["Daily_StopCapture"]
    },
    "DailyGift_Bottom": {
        "recognition": "And",
        "all_of": [
            {"recognition": "TemplateMatch", "template": "daily/gift_bottom.png",
             "roi": [696, 1028, 8, 28], "threshold": 0.99},
            {"recognition": "ColorMatch", "method": 4, "roi": [697, 1038, 6, 15],
             "lower": [95, 55, 40], "upper": [125, 90, 75], "count": 70}
        ]
    },
    "DailyGift_ListReady": {
        "recognition": "And",
        "all_of": ["Daily_GiftPage", "DailyGift_Tab", "DailyGift_PositiveQuota",
                   "NavFooter_Home", "DailyGift_Bottom"]
    },
    "DailyGift_BottomProved": {
        "recognition": "And", "all_of": ["DailyGift_ListReady"], "post_delay": 0,
        "anchor": {"DailyGift_SearchPermit": "DailyGift_SearchScan",
                   "DailyGift_BottomProof": "DailyGift_BottomProved"},
        "next": ["[Anchor]DailyGift_SearchPermit"], "on_error": ["Daily_StopCapture"]
    },
    "DailyGift_NoProof": {"recognition": "DirectHit", "enabled": false},
    "DailyGift_SearchReady": {
        "recognition": "And",
        "all_of": [
            "Daily_GiftPage", "DailyGift_Tab", "DailyGift_PositiveQuota", "NavFooter_Home",
            {"recognition": "Or", "any_of": [
                "DailyGift_Bottom",
                {"recognition": "TemplateMatch", "template": "daily/gift_title.png",
                 "roi": "[Anchor]DailyGift_BottomProof", "threshold": 0.97}
            ]}
        ]
    },
    "DailyGift_SelectGate": {
        "recognition": "DirectHit", "post_delay": 0,
        "next": ["DailyGift_BottomProved", "Daily_StopCapture"], "on_error": ["Daily_StopCapture"]
    },
    "DailyGift_Cleared": {
        "recognition": "And", "all_of": [
            {"recognition": "TemplateMatch",
             "template": ["daily/gift_cleared.png", "daily/gift_cleared_phase.png"],
             "roi": [65, 220, 95, 820], "threshold": 0.97, "order_by": "Vertical", "index": -1}
        ]
    },
    "DailyGift_SearchScan": {
        "recognition": "And", "all_of": ["DailyGift_SearchReady"], "post_delay": 0,
        "next": ["DailyGift_HasClearedGate", "DailyGift_SearchUp", "Daily_StopCapture"],
        "on_error": ["Daily_StopCapture"]
    },
    "DailyGift_HasClearedGate": {
        "recognition": "And", "all_of": ["DailyGift_SearchReady", "DailyGift_Cleared"], "post_delay": 0,
        "next": ["DailyGift_Prepare", "Daily_StopCapture"], "on_error": ["Daily_StopCapture"]
    },
    "DailyGift_SearchUp": {
        "recognition": "And", "all_of": ["DailyGift_SearchReady"],
        "action": "Swipe", "begin": [410, 330], "end": [410, 730], "duration": 400,
        "max_hit": 8, "post_delay": 700,
        "next": ["[Anchor]DailyGift_SearchPermit"], "on_error": ["Daily_StopCapture"]
    },
    "DailyGift_Prepare": {
        "recognition": "And",
        "all_of": [
            "DailyGift_SearchReady",
            {"recognition": "And", "all_of": ["DailyGift_Cleared"], "sub_name": "cleared"},
            {"recognition": "TemplateMatch", "template": "daily/gift_prepare.png", "roi": "cleared",
             "roi_offset": [435, -20, 100, 20], "threshold": 0.97, "sub_name": "prepare"},
            {"recognition": "ColorMatch", "method": 4, "roi": "prepare",
             "lower": [220, 45, 55], "upper": [255, 130, 145], "count": 2500}
        ],
        "box_index": 2, "action": "Click", "target": true, "max_hit": 1,
        "post_delay": 1800, "timeout": 30000,
        "next": ["Daily_PostError", "DailyGift_PrepDispatch"], "on_error": ["Daily_StopCapture"]
    },
    "DailyGift_QuickLabel": {
        "recognition": "TemplateMatch", "template": "daily/gift_quick_label.png",
        "roi": [532, 1108, 125, 42], "threshold": 0.97
    },
    "DailyGift_Checked": {
        "recognition": "TemplateMatch", "template": "daily/gift_quick_checked.png",
        "roi": [500, 1112, 32, 32], "threshold": 0.99
    },
    "DailyGift_Unchecked": {
        "recognition": "TemplateMatch", "template": "daily/gift_quick_unchecked.png",
        "roi": [500, 1112, 32, 32], "threshold": 0.99
    },
    "DailyGift_PrepReady": {
        "recognition": "And",
        "all_of": [
            "Daily_PrepPage", "DailyGift_QuickLabel",
            {"recognition": "TemplateMatch", "template": "daily/start.png",
             "roi": [220, 1085, 280, 90], "threshold": 0.97},
            {"recognition": "ColorMatch", "method": 4, "roi": [245, 1113, 225, 35],
             "lower": [220, 45, 55], "upper": [255, 130, 145], "count": 4000}
        ]
    },
    "DailyGift_PrepDispatch": {
        "recognition": "And", "all_of": ["DailyGift_PrepReady"], "post_delay": 0,
        "next": ["DailyGift_CheckedGate", "DailyGift_UncheckedGate", "Daily_StopCapture"],
        "on_error": ["Daily_StopCapture"]
    },
    "DailyGift_CheckedGate": {
        "recognition": "And", "all_of": ["DailyGift_PrepReady", "DailyGift_Checked"], "post_delay": 0,
        "next": ["DailyGift_QuickSpend", "Daily_StopCapture"], "on_error": ["Daily_StopCapture"]
    },
    "DailyGift_UncheckedGate": {
        "recognition": "And", "all_of": ["DailyGift_PrepReady", "DailyGift_Unchecked"], "post_delay": 0,
        "next": ["DailyGift_EnableQuick", "Daily_StopCapture"], "on_error": ["Daily_StopCapture"]
    },
    "DailyGift_EnableQuick": {
        "recognition": "And", "all_of": ["DailyGift_PrepReady", "DailyGift_Unchecked"],
        "action": "Click", "target": [505, 1117, 21, 21], "max_hit": 1, "post_delay": 400,
        "next": ["DailyGift_PrepDispatch"], "on_error": ["Daily_StopCapture"]
    },
    "DailyGift_QuickSpend": {
        "recognition": "And", "all_of": ["DailyGift_PrepReady", "DailyGift_Checked"],
        "action": "Click", "target": [345, 1115, 30, 25], "max_hit": 1,
        "post_delay": 1200, "timeout": 45000,
        "next": ["Daily_PostError", "DailyGift_ResultGate"], "on_error": ["Daily_StopCapture"],
        "attach": {"quick": true, "stage": "highest-cleared-at-confirmed-bottom"}
    },
    "DailyGift_ResultReady": {
        "recognition": "And",
        "all_of": [
            {"recognition": "OCR", "roi": [0, 595, 350, 130], "only_rec": true,
             "expected": ["^Win[!！]?$"], "threshold": 0.95},
            {"recognition": "TemplateMatch", "template": "daily/gift_ok.png",
             "roi": [220, 1155, 290, 90], "threshold": 0.97},
            {"recognition": "ColorMatch", "method": 4, "roi": [250, 1185, 220, 30],
             "lower": [220, 45, 55], "upper": [255, 130, 145], "count": 3500}
        ],
        "box_index": 1
    },
    "DailyGift_ResultGate": {
        "recognition": "And", "all_of": ["DailyGift_ResultReady"], "post_delay": 0,
        "next": ["DailyGift_ResultOK", "Daily_StopCapture"], "on_error": ["Daily_StopCapture"]
    },
    "DailyGift_ResultOK": {
        "recognition": "And", "all_of": ["DailyGift_ResultReady"],
        "action": "Click", "target": true, "max_hit": 1, "post_delay": 800, "timeout": 30000,
        "next": ["Daily_PostError", "DailyGift_ResultHome"], "on_error": ["Daily_StopCapture"]
    },
    "DailyGift_ResultHome": {
        "recognition": "And", "all_of": ["Daily_GiftPage", "NavFooter_Home"],
        "action": "Click", "target": [345, 1220, 30, 20], "max_hit": 1,
        "post_delay": 2000, "timeout": 30000,
        "next": ["Daily_PostError", "DailyCore_Done"], "on_error": ["Daily_StopCapture"]
    }
}
