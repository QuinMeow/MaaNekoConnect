{
    "interface_version": 2,
    "name": "MaaNekoConnect",
    "description": "使用 MaaFramework 自动化ネココネ。",
    "contact": "https://github.com/QuinMeow/MaaNekoConnect/issues",
    "license": "MIT",
    "github": "https://github.com/QuinMeow/MaaNekoConnect",
    "version": "0.1.0",
    "controller": [
        {
            "name": "Android",
            "label": "Android 模拟器",
            "type": "Adb",
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "默认资源",
            "path": [
                "./resource"
            ],
            "controller": [
                "Android"
            ]
        }
    ],
    "agent": {
        "child_exec": "python",
        "child_args": [
            "../agent/main.py"
        ]
    },
    "task": [
        {
            "name": "框架测试：启动游戏并截图",
            "entry": "TestLaunchAndCapture",
            "controller": [
                "Android"
            ]
        }
    ]
}
