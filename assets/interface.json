{
    "interface_version": 2,
    "name": "MaaNekoConnect",
    "description": "使用 MaaFramework 自动化ネココネ。",
    "contact": "https://github.com/QuinMeow/MaaNekoConnect/issues",
    "license": "MIT",
    "github": "https://github.com/QuinMeow/MaaNekoConnect",
    "version": "0.1.0",
    "controller": [
        {
            "name": "Android",
            "label": "Android 模拟器",
            "type": "Adb",
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "默认资源",
            "path": [
                "./resource"
            ],
            "controller": [
                "Android"
            ]
        }
    ],
    "agent": {
        "child_exec": "python",
        "child_args": [
            "../agent/main.py"
        ]
    },
    "task": [
        {
            "name": "框架测试：启动游戏并截图",
            "entry": "TestLaunchAndCapture",
            "controller": [
                "Android"
            ]
        },
        {
            "name": "自动强化 Soleil 花坛",
            "entry": "SoleilFlowerbedAutoUpgrade",
            "controller": [
                "Android"
            ],
            "option": [
                "FlowerbedSettings"
            ]
        }
    ],
    "option": {
        "FlowerbedSettings": {
            "type": "input",
            "label": "Soleil 花坛设置",
            "description": "默认仅规划。Execute 在识别证据不足时会关闭失败，不使用加速道具或社团委托。",
            "inputs": [
                {
                    "name": "ExecutionMode",
                    "label": "执行模式",
                    "default": "PlanOnly",
                    "pipeline_type": "string",
                    "verify": "^(?:PlanOnly|Execute)$",
                    "pattern_msg": "请输入 PlanOnly 或 Execute。"
                },
                {
                    "name": "DeadlineHours",
                    "label": "期限（小时）",
                    "default": "24",
                    "pipeline_type": "int",
                    "verify": "^\\d+$",
                    "pattern_msg": "请输入非负整数小时。"
                },
                {
                    "name": "MaxStarts",
                    "label": "最多启动数",
                    "default": "6",
                    "pipeline_type": "int",
                    "verify": "^[1-6]$",
                    "pattern_msg": "请输入 1 到 6。"
                },
                {
                    "name": "AllowTailFill",
                    "label": "允许期限外尾填充",
                    "default": "false",
                    "pipeline_type": "string",
                    "verify": "^(?:true|false)$",
                    "pattern_msg": "请输入 true 或 false。"
                },
                {
                    "name": "KagayakiReserve",
                    "label": "輝きの花 reserve",
                    "default": "0",
                    "pipeline_type": "int",
                    "verify": "^\\d+$"
                },
                {
                    "name": "ChosenReserve",
                    "label": "挑戦の花 reserve",
                    "default": "0",
                    "pipeline_type": "int",
                    "verify": "^\\d+$"
                },
                {
                    "name": "KyoryokuReserve",
                    "label": "協力の花 reserve",
                    "default": "0",
                    "pipeline_type": "int",
                    "verify": "^\\d+$"
                },
                {
                    "name": "NazoReserve",
                    "label": "謎めきの花 reserve",
                    "default": "0",
                    "pipeline_type": "int",
                    "verify": "^\\d+$"
                },
                {
                    "name": "WorkSpeedWeight",
                    "label": "作业速度 fallback 权重",
                    "default": "0.1",
                    "pipeline_type": "string",
                    "verify": "^\\d+(?:\\.\\d+)?$"
                },
                {
                    "name": "StaminaWeight",
                    "label": "Stamina fallback 权重",
                    "default": "0.01",
                    "pipeline_type": "string",
                    "verify": "^\\d+(?:\\.\\d+)?$"
                }
            ],
            "pipeline_override": {
                "SoleilFlowerbedPlanAndExecute": {
                    "custom_action_param": {
                        "execution_mode": "{ExecutionMode}",
                        "deadline_hours": "{DeadlineHours}",
                        "max_starts": "{MaxStarts}",
                        "allow_tail_fill": "{AllowTailFill}",
                        "kagayaki_reserve": "{KagayakiReserve}",
                        "chosen_reserve": "{ChosenReserve}",
                        "kyoryoku_reserve": "{KyoryokuReserve}",
                        "nazo_reserve": "{NazoReserve}",
                        "work_speed_weight": "{WorkSpeedWeight}",
                        "stamina_weight": "{StaminaWeight}"
                    }
                }
            }
        }
    }
}
