{
    "interface_version": 2,
    "name": "MaaNekoConnect",
    "description": "使用 MaaFramework 自动化ネココネ。",
    "contact": "https://github.com/QuinMeow/MaaNekoConnect/issues",
    "license": "MIT",
    "github": "https://github.com/QuinMeow/MaaNekoConnect",
    "controller": [
        {
            "name": "Android",
            "label": "Android 模拟器",
            "type": "Adb",
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "默认资源",
            "path": [
                "./resource"
            ],
            "controller": [
                "Android"
            ]
        }
    ],
    "agent": {
        "child_exec": "../.runtime/python/python.exe",
        "child_args": [
            "../agent/main.py"
        ]
    },
    "task": [
        {
            "name": "启动游戏",
            "entry": "DailyLogin_Start",
            "controller": ["Android"],
            "description": "游戏未在前台时启动或切回游戏，已在前台则直接继续；登录并确认首页，关闭登录奖励、公告和活动提示。"
        },
        {
            "name": "好友问候",
            "entry": "DailyFriend_Start",
            "controller": [
                "Android"
            ],
            "description": "好友列表一键问候。"
        },
        {
            "name": "营业收入领取",
            "entry": "DailyIncome_Start",
            "controller": [
                "Android"
            ],
            "description": "领取普通营业收入，不追加收益。"
        },
        {
            "name": "配送管理",
            "entry": "DailyDelivery_Start",
            "controller": [
                "Android"
            ],
            "description": "先领取已完成单、自动编队派完当前订单，再用每日一次免费刷新并派完新单。"
        },
        {
            "name": "家具强化",
            "entry": "FurnitureSchedule_Start",
            "controller": [
                "Android"
            ],
            "option": [
                "FurnitureSchedule",
                "UseExistingSort",
                "AutoRequest"
            ],
            "default_check": false,
            "resource": [],
            "description": "为列表前五位的家具启用强化"
        },
        {
            "name": "邮箱领取",
            "entry": "DailyMail_Start",
            "controller": [
                "Android"
            ],
            "description": "领取邮箱可领取内容；"
        },
        {
            "name": "社团事务",
            "entry": "DailyGuild_Start",
            "controller": [
                "Android"
            ],
            "description": "进入社团执行已配置日常。",
            "option": [
                "DailyGuildGoldDonation"
            ]
        },
        {
            "name": "礼物关卡",
            "entry": "DailyGift_Start",
            "controller": [
                "Android"
            ],
            "description": "选择列表最下方已通关关卡，默认快速开店一次；"
        },
        {
            "name": "VR猫爬塔",
            "entry": "DailyVR_Start",
            "controller": [
                "Android"
            ],
            "description": "使用免费次数完成VR猫爬塔"
        },
        {
            "name": "竞技场",
            "entry": "DailyContest_Start",
            "controller": [
                "Android"
            ],
            "description": "使用现有队伍进行一次免费JJC挑战"
        },
        {
            "name": "交换所兑换",
            "entry": "DailyExchange_Start",
            "controller": [
                "Android"
            ],
            "description": "仅购买现有随机商品一件、数量一、1000金币；不刷新，不使用其他货币。"
        },
        {
            "name": "广告抽卡",
            "entry": "DailyGacha_Start",
            "controller": [
                "Android"
            ],
            "description": "独立进入免费广告入口；只在确认免费许可和明确关闭控件时继续。"
        },
        {
            "name": "任务奖励领取",
            "entry": "DailyRewards_Start",
            "controller": [
                "Android"
            ],
            "description": "仅领取每日、汇总及已达标DayPt奖励，不执行其他玩法；请在需要的任务之后勾选。",
            "option": [
                "DailyMilestones"
            ]
        }
    ],
    "option": {
        "DailyMilestones": {
            "type": "switch",
            "label": "领取已达标的DayPt阶段奖励",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "Daily_Milestone": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Daily_Milestone": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "UseExistingSort": {
            "type": "switch",
            "label": "使用现有排序",
            "description": "开启时不更改当前排序和筛选。关闭后显示下方排序与筛选设置。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "FurnitureEnhance_Prepare": {
                            "next": [
                                "FurnitureEnhance_ScrollTop"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "option": [
                        "SortOrder",
                        "OnlyPlaced",
                        "OnlyUpgradeable"
                    ],
                    "pipeline_override": {
                        "FurnitureEnhance_Prepare": {
                            "next": [
                                "FurnitureFilter_OpenSort"
                            ]
                        }
                    }
                }
            ]
        },
        "SortOrder": {
            "type": "select",
            "label": "排序方式",
            "default_case": "lv_asc",
            "cases": [
                {
                    "name": "lv_asc",
                    "label": "Lv 升序",
                    "pipeline_override": {
                        "FurnitureFilter_Direction": {
                            "next": [
                                "FurnitureFilter_AscendingReady",
                                "FurnitureFilter_FlipToAscending"
                            ]
                        }
                    }
                },
                {
                    "name": "lv_desc",
                    "label": "Lv 降序",
                    "pipeline_override": {
                        "FurnitureFilter_Direction": {
                            "next": [
                                "FurnitureFilter_DescendingReady",
                                "FurnitureFilter_FlipToDescending"
                            ]
                        }
                    }
                }
            ]
        },
        "OnlyPlaced": {
            "type": "switch",
            "label": "仅已配置家具",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "FurnitureFilter_FilterPlaced": {
                            "next": [
                                "FurnitureFilter_PlacedOn"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "FurnitureFilter_FilterPlaced": {
                            "next": [
                                "FurnitureFilter_PlacedOff"
                            ]
                        }
                    }
                }
            ]
        },
        "OnlyUpgradeable": {
            "type": "switch",
            "label": "仅可升级家具",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "FurnitureFilter_FilterUpgradeable": {
                            "next": [
                                "FurnitureFilter_UpgradeableOn"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "FurnitureFilter_FilterUpgradeable": {
                            "next": [
                                "FurnitureFilter_UpgradeableOff"
                            ]
                        }
                    }
                }
            ]
        },
        "AutoRequest": {
            "type": "switch",
            "label": "本轮补位完成后点击依頼",
            "description": "仅本轮至少确认一次新强化后请求，整轮最多点击一次；关闭时轮末直接结束或等待。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "FurnitureEnhance_AfterStart": {
                            "anchor": {
                                "FurnitureEnhance_PostRound": "FurnitureEnhance_ReturnForRequest"
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "FurnitureEnhance_AfterStart": {
                            "anchor": {
                                "FurnitureEnhance_PostRound": "FurnitureEnhance_RoundComplete"
                            }
                        }
                    }
                }
            ]
        },
        "FurnitureSchedule": {
            "type": "select",
            "label": "运行方式",
            "description": "单轮立即补位后结束。间隔模式首轮立即执行，后续按固定或可见忙碌家具的剩余时间等待；识别失败回退固定间隔。",
            "default_case": "single",
            "cases": [
                {
                    "name": "single",
                    "label": "仅运行一轮",
                    "pipeline_override": {
                        "FurnitureTimer_Config": {
                            "custom_action_param": {
                                "op": "config",
                                "mode": "fixed"
                            }
                        },
                        "FurnitureSchedule_Permit": {
                            "max_hit": 1
                        }
                    }
                },
                {
                    "name": "fixed",
                    "label": "固定间隔",
                    "pipeline_override": {
                        "FurnitureTimer_Config": {
                            "custom_action_param": {
                                "op": "config",
                                "mode": "fixed"
                            }
                        }
                    },
                    "option": [
                        "FurnitureRounds",
                        "FurnitureInterval"
                    ]
                },
                {
                    "name": "shortest",
                    "label": "最短剩余时间",
                    "pipeline_override": {
                        "FurnitureTimer_Config": {
                            "custom_action_param": {
                                "op": "config",
                                "mode": "shortest"
                            }
                        }
                    },
                    "option": [
                        "FurnitureRounds",
                        "FurnitureInterval"
                    ]
                },
                {
                    "name": "longest",
                    "label": "最长剩余时间",
                    "pipeline_override": {
                        "FurnitureTimer_Config": {
                            "custom_action_param": {
                                "op": "config",
                                "mode": "longest"
                            }
                        }
                    },
                    "option": [
                        "FurnitureRounds",
                        "FurnitureInterval"
                    ]
                }
            ]
        },
        "FurnitureRounds": {
            "type": "input",
            "label": "总轮数",
            "description": "含立即执行的首轮；1 至 10000，每轮最多尝试启动五件。",
            "inputs": [
                {
                    "name": "Rounds",
                    "label": "轮数",
                    "default": "1",
                    "pipeline_type": "int",
                    "verify": "^(?:[1-9][0-9]{0,3}|10000)$",
                    "pattern_msg": "请输入 1 至 10000 的整数"
                }
            ],
            "pipeline_override": {
                "FurnitureSchedule_Permit": {
                    "max_hit": "{Rounds}"
                }
            }
        },
        "FurnitureInterval": {
            "type": "input",
            "label": "固定／回退间隔",
            "description": "单位为秒，10 至 86400。动态倒计时无法安全读取时使用此值，不使用零秒重试。",
            "inputs": [
                {
                    "name": "Seconds",
                    "label": "秒",
                    "default": "60",
                    "pipeline_type": "int",
                    "verify": "^(?:[1-9][0-9]{1,3}|[1-7][0-9]{4}|8[0-5][0-9]{3}|86[0-3][0-9]{2}|86400)$",
                    "pattern_msg": "请输入 10 至 86400 的整数"
                }
            ],
            "pipeline_override": {
                "FurnitureTimer_IntervalConfig": {
                    "custom_action_param": {
                        "op": "interval",
                        "seconds": "{Seconds}"
                    }
                }
            }
        },
        "DailyGuildGoldDonation": {
            "type": "switch",
            "label": "社团金币赞助（每次1000，最多10次）",
            "description": "默认关闭。只点击上方金币按钮，每次确认余数递减后继续，最多10000金币；不使用钻石。",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "DailyGuild_DonateSelect": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "DailyGuild_DonateSelect": {
                            "enabled": false
                        }
                    }
                }
            ]
        }
    },
    "group": [],
    "version": "1.0.0"
}
